# Goal: command the Dolly lift actuator.
uint8 LIFT_UP=1
uint8 LIFT_DOWN=2

string amr_id
string task_id
uint8 command
---
# Result: actuator operation completion.
bool success
string message
float32 final_position
---
# Feedback: current actuator state and target error.
string state
float32 current_position
float32 target_position
float32 error
