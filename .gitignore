# Navigation map source assets
ros2_ws/src/navigation/maps/factory/Usd_Explorer/
ros2_ws/src/navigation/maps/factory/PACKAGE-LICENSES/
ros2_ws/src/navigation/maps/factory/PACKAGE-INFO.yaml

# Vision / solver virtualenvs (large, machine-specific).
# No trailing slash: on this machine .venv_vision is a symlink into a sibling
# checkout, and a directory-only pattern would leave the link untracked-but-
# visible in every `git status`.
/.venv_vision
/.venvs/

# Generated by the bridge on every start; contains machine-specific absolute
# paths to the USD it opened, so committing it would break "no absolute path
# dependency" for anyone else cloning this.
simulation/isaac_sim/factory_inventory.json
simulation/isaac_sim/factory_inventory.txt

# Written by scripts/plan_cuopt.py. Regenerate rather than commit: it is only
# valid for the task set it was solved for.
simulation/isaac_sim/cuopt_plan.json

# Unpacked PyTorch checkpoint internals, and Git LFS pointer files that never
# resolved to real images. Neither is usable input.
/dolly_pose_v1_best/
/train/

# Run logs. Kept in the repository rather than /tmp so a run is inspectable
# from the checkout and survives a reboot, but the contents are per-run.
/logs/*
!/logs/.gitkeep
